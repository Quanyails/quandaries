{
  "meta": {
    "resources": [
      "https://generalisms.com/constructing/",
      "https://redd.it/nqsuku/",
      "https://tcampbell.substack.com/p/shopping-for-wordlists"
    ],
    "updated": "2025-10-01"
  },
  "filters": {
    "min_score": 20
  },
  "score_path": "scores.txt",
  "out": {
    "base": "out/base.dict",
    "combined": "out/combined.dict",
    "extended": "out/extended.dict",
    "frequencies": "out/freq.png",
    "overrides": "out/overrides.dict",
    "postprocessed": "out/postprocessed.dict"
  },
  "overrides": {
    "data": [
      {
        "is_additive": true,
        "word_path": "overrides/additions.txt"
      },
      {
        "sort": "prep",
        "word_path": "overrides/phrasal.txt"
      },
      {
        "sort": "prep",
        "word_path": "overrides/phrasalirregular.txt"
      },
      {
        "sort": "length",
        "word_path": "overrides/words-3000.txt"
      },
      {
        "sort": "length",
        "word_path": "overrides/words-main.txt"
      }
    ],
    "path": "overrides"
  },
  "extended": [
    {
      "name": "spreadthewordlist",
      "path": "in/spreadthewordlist.dict",
      "range": [0, 50],
      "transform": "NOOP",
      "source": "https://www.spreadthewordlist.com/",
      "updated": "2026-01-01"
    }
  ],
  "unused": [
    {
      "path": "in/christophsjones.txt",
      "name": "christophsjones",
      "range": [0, 50],
      "transform": "NOOP",
      "source": "https://github.com/christophsjones/crossword-wordlist",
      "updated": "2020-01-09"
    },
    {
      "name": "adanicole",
      "path": "in/adanicole.dict",
      "range": [100, 100],
      "transform": "HALVE",
      "source": "https://generalisms.com/constructing/",
      "updated": "unknown"
    },
    {
      "name": "brianthomas",
      "path": "in/brianthomas.dict",
      "range": [69, 69],
      "transform": "HALVE",
      "source": "https://generalisms.com/constructing/",
      "updated": "2023-06-10"
    },
    {
      "name": "brodatrimmed",
      "path": "in/brodatrimmed.txt",
      "range": [20, 50],
      "transform": "NOOP",
      "source": "https://redd.it/nqsuku/",
      "updated": "2020-06-20"
    },
    {
      "name": "mattabate",
      "path": "in/matt.txt",
      "range": [0, 50],
      "transform": "NOOP",
      "source": "https://github.com/mattabate/wordlist",
      "updated": "2025-06-28"
    },
    {
      "name": "crosswordnexus",
      "path": "in/crosswordnexus.dict",
      "range": [0, 100],
      "transform": "HALVE",
      "source": "https://www.alexboisvert.com/xwordlist/",
      "updated": "2023-02-12"
    }
  ],
  "wordlists": [
    {
      "name": "jkugelman",
      "path": "in/jkugelman.txt",
      "range": [0, 50],
      "transform": "NOOP",
      "source": "https://github.com/jkugelman/crossword/blob/main/wordlists/jkugelman-wordlist.txt",
      "updated": "2025-12-04"
    },
    {
      "name": "xwordinfo",
      "path": "in/xwordinfo.txt",
      "range": [5, 60],
      "transform": "XWI",
      "source": "https://www.xwordinfo.com/WordList",
      "updated": "2025-10-02?"
    },
    {
      "name": "nediger",
      "path": "in/nediger.txt",
      "range": [0, 100],
      "source": "https://github.com/bewilderingly/Nediger-list",
      "transform": "NEDIGER",
      "updated": "2026-06-08"
    }
  ]
}